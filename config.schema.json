          "api_key_scheme": {
            "enum": [
              "bearer",
              "raw"
            ]
          },
          "headers": {
            "type": "object",
            "maxProperties": 16,
            "propertyNames": {
              "type": "string",
              "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]{1,64}$"
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^[^\\x00-\\x1f]+$"
            }
          },
          "headers_env": {
            "type": "object",
            "maxProperties": 16,
            "propertyNames": {
              "type": "string",
              "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]{1,64}$"
            },
            "additionalProperties": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"
            }
          },
          "generation": {
            "type": "object",
            "properties": {
              "max_tokens": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65536
              },
              "thinking": {
                "type": "boolean"
              },
              "temperature": {
                "type": "number",
                "minimum": 0,
                "maximum": 2
              },
              "top_p": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "seed": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2147483647
              },
              "reasoning_effort": {
                "enum": [
                  "none",
                  "minimal",
                  "low",
                  "medium",
                  "high",
                  "xhigh",
                  "max"
                ]
              },
              "token_limit_field": {
                "enum": [
                  "max_tokens",
                  "max_completion_tokens"
                ]
              },
              "extra_body": {
                "type": "object",
                "maxProperties": 32,
                "propertyNames": {
                  "not": {
                    "enum": [
                      "api_key",
                      "base_url",
                      "headers",
                      "input",
                      "instructions",
                      "max_completion_tokens",
                      "max_tokens",
                      "messages",
                      "model",
                      "n",
                      "prompt",
                      "reasoning_effort",
                      "seed",
                      "stream",
                      "stream_options",
                      "system",
                      "temperature",
                      "tool_choice",
                      "tools",
                      "top_p"
                    ]
                  }
                },
                "description": "Provider-specific JSON fields; <=16 KiB, depth <=12. Reserved request/security fields are rejected."
              }
            },
            "additionalProperties": false
          },
          "models": {
            "type": "object",
            "maxProperties": 64,
            "propertyNames": {
              "pattern": "^[A-Za-z0-9_-]{1,64}$"
            },
            "additionalProperties": {
