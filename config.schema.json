              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "pattern": "^[^\\x00-\\x1f]+$"
                },
                "generation": {
                  "type": "object",
                  "properties": {
                    "max_tokens": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 65536
                    },
