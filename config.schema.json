      "pattern": "^[^\\x00-\\x1f]+$"
    },
    "interface": {
      "enum": [
        "cli",
        "chat",
        "tui"
      ]
    },
    "providers": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_-]{1,64}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[^\\x00-\\x1f]+$"
          },
          "base_url": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^[^\\x00-\\x1f]+$"
          },
          "api_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^[^\\x00-\\x1f]+$",
            "writeOnly": true
          },
          "api_key_env": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"
          },
          "request_timeout": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 120
          },
          "proxy": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^[^\\x00-\\x1f]+$",
            "description": "system, direct, or an HTTP(S) proxy URL without credentials."
          },
          "api_key_header": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^[^\\x00-\\x1f]+$"
