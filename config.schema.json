                      "minimum": 0,
                      "maximum": 2147483647
                    },
                    "reasoning_effort": {
                      "enum": [
                        "none",
                        "minimal",
                        "low",
                        "medium",
                        "high",
                        "xhigh",
                        "max"
                      ]
                    },
                    "token_limit_field": {
                      "enum": [
                        "max_tokens",
                        "max_completion_tokens"
                      ]
                    },
                    "extra_body": {
                      "type": "object",
                      "maxProperties": 32,
                      "propertyNames": {
                        "not": {
                          "enum": [
                            "api_key",
                            "base_url",
                            "headers",
                            "input",
                            "instructions",
                            "max_completion_tokens",
                            "max_tokens",
                            "messages",
                            "model",
                            "n",
                            "prompt",
                            "reasoning_effort",
                            "seed",
                            "stream",
                            "stream_options",
                            "system",
                            "temperature",
                            "tool_choice",
                            "tools",
                            "top_p"
                          ]
                        }
                      },
                      "description": "Provider-specific JSON fields; <=16 KiB, depth <=12. Reserved request/security fields are rejected."
                    }
                  },
                  "additionalProperties": false
                },
                "max_context_bytes": {
                  "type": "integer",
                  "minimum": 4096,
                  "maximum": 2097152
                }
              },
              "additionalProperties": false,
              "required": [
                "id"
              ]
            }
          }
        },
        "additionalProperties": false,
        "not": {
          "required": [
            "api_key",
            "api_key_env"
          ]
        }
      }
    },
