{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sprig user configuration",
  "description": "Private TOML, schema version 1. Cross-field, endpoint, path and permission restrictions are additionally checked at runtime.",
  "type": "object",
  "properties": {
    "agent": {
      "type": "object",
      "properties": {
        "max_steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "timeout": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 120
        },
        "max_output": {
          "type": "integer",
          "minimum": 256,
          "maximum": 1000000
        },
        "max_context_bytes": {
          "type": "integer",
          "minimum": 4096,
          "maximum": 2097152
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "checks": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "items": {
              "type": "string"
            }
          }
        },
        "stream": {
          "type": "boolean"
        },
        "thinking": {
          "type": "boolean"
        },
        "read_only": {
          "type": "boolean"
        },
        "inherit_env": {
          "type": "boolean"
        },
        "compact_context": {
          "type": "boolean"
        },
        "request_usage": {
          "type": "boolean"
        },
        "project_instructions": {
          "type": "boolean"
        },
        "check_before_task": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "generation": {
      "type": "object",
      "properties": {
        "max_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "thinking": {
          "type": "boolean"
        },
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "top_p": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "reasoning_effort": {
          "enum": [
            "none",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ]
        },
        "token_limit_field": {
          "enum": [
            "max_tokens",
            "max_completion_tokens"
          ]
        },
        "extra_body": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "not": {
              "enum": [
                "api_key",
                "base_url",
                "headers",
                "input",
                "instructions",
                "max_completion_tokens",
                "max_tokens",
                "messages",
                "model",
                "n",
                "prompt",
                "reasoning_effort",
                "seed",
                "stream",
                "stream_options",
                "system",
                "temperature",
                "tool_choice",
                "tools",
                "top_p"
              ]
            }
          },
          "description": "Provider-specific JSON fields; <=16 KiB, depth <=12. Reserved request/security fields are rejected."
        }
      },
      "additionalProperties": false
    },
    "tools": {
      "type": "object",
      "properties": {
        "list_files": {
          "type": "boolean"
        },
        "read_file": {
          "type": "boolean"
        },
        "search": {
          "type": "boolean"
        },
        "project_map": {
          "type": "boolean"
        },
        "edit_file": {
          "type": "boolean"
        },
        "run": {
          "type": "boolean"
        },
        "update_plan": {
          "type": "boolean"
        },
        "edit_lines": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "files": {
      "type": "object",
      "properties": {
        "exclude": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\x00-\\x1f]+$"
          },
          "description": "Relative POSIX glob patterns; no !, .. components, backslashes or absolute paths. Adds to .sprigignore."
        }
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "properties": {
        "inherit_env": {
          "type": "boolean"
        },
        "timeout": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 120
        },
        "max_output": {
          "type": "integer",
          "minimum": 256,
          "maximum": 1000000
        },
        "env_allowlist": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"
          }
        },
        "env": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 8192
          }
        }
      },
      "additionalProperties": false
    },
    "storage": {
      "type": "object",
      "properties": {
        "session_dir": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[^\\x00-\\x1f]+$"
        },
        "change_history_dir": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[^\\x00-\\x1f]+$"
        },
        "auto_save_session": {
          "type": "boolean"
        },
        "session_max_age_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 36500
        },
        "session_max_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        }
      },
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "properties": {
        "max_bytes": {
          "type": "integer",
          "minimum": 4096,
          "maximum": 2097152
        },
        "compact": {
          "type": "boolean"
        },
        "trigger_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "keep_recent_messages": {
          "type": "integer",
          "minimum": 6,
          "maximum": 1000
        }
      },
      "additionalProperties": false
    },
    "instructions": {
      "type": "object",
      "properties": {
        "files": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\x00-\\x1f]+$"
          },
          "description": "Required workspace-relative UTF-8 files; no globs. Existing privacy and instruction limits apply."
        },
        "response_language": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[^\\x00-\\x1f]+$"
        }
      },
      "additionalProperties": false
    },
    "tui": {
      "type": "object",
      "properties": {
        "theme": {
          "enum": [
            "textual-dark",
            "textual-light",
            "nord",
            "gruvbox",
            "dracula",
            "monokai",
            "tokyo-night",
            "solarized-dark",
            "solarized-light"
          ]
        },
        "sidebar": {
          "type": "boolean"
        },
        "editor_height": {
          "type": "integer",
          "minimum": 3,
          "maximum": 12
        },
        "steering_mode": {
          "enum": [
            "all",
            "one-at-a-time"
          ]
        },
        "metrics": {
          "type": "boolean"
        },
        "keybindings": {
          "type": "object",
          "properties": {
            "cancel": {
              "type": "array",
              "maxItems": 4,
              "items": {
                "type": "string",
                "pattern": "^(?:(?:ctrl|alt|shift)\\+)*(?:f(?:[1-9]|1[0-2])|[a-z0-9]|home|end|pageup|pagedown|up|down|left|right)$"
              }
            },
            "quit": {
              "type": "array",
              "maxItems": 4,
              "items": {
                "type": "string",
                "pattern": "^(?:(?:ctrl|alt|shift)\\+)*(?:f(?:[1-9]|1[0-2])|[a-z0-9]|home|end|pageup|pagedown|up|down|left|right)$"
              }
            },
            "focus_input": {
              "type": "array",
              "maxItems": 4,
              "items": {
                "type": "string",
                "pattern": "^(?:(?:ctrl|alt|shift)\\+)*(?:f(?:[1-9]|1[0-2])|[a-z0-9]|home|end|pageup|pagedown|up|down|left|right)$"
              }
            },
            "toggle_sidebar": {
              "type": "array",
              "maxItems": 4,
              "items": {
                "type": "string",
                "pattern": "^(?:(?:ctrl|alt|shift)\\+)*(?:f(?:[1-9]|1[0-2])|[a-z0-9]|home|end|pageup|pagedown|up|down|left|right)$"
              }
            },
            "help": {
              "type": "array",
              "maxItems": 4,
              "items": {
                "type": "string",
                "pattern": "^(?:(?:ctrl|alt|shift)\\+)*(?:f(?:[1-9]|1[0-2])|[a-z0-9]|home|end|pageup|pagedown|up|down|left|right)$"
              }
            },
            "new_conversation": {
              "type": "array",
              "maxItems": 4,
              "items": {
                "type": "string",
                "pattern": "^(?:(?:ctrl|alt|shift)\\+)*(?:f(?:[1-9]|1[0-2])|[a-z0-9]|home|end|pageup|pagedown|up|down|left|right)$"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "schema_version": {
      "const": 1
    },
    "provider": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^\\x00-\\x1f]+$"
    },
    "profile": {
      "type": "string",
